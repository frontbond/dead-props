{
  "name": "dead-props",
  "version": "0.1.1",
  "description": "Find component props declared in a *Props interface/type that no JSX call site in the project ever passes — cross-file, TypeScript-aware, monorepo-friendly.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dead-props": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "knip": "knip",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "react",
    "typescript",
    "props",
    "dead-code",
    "unused-props",
    "design-system",
    "monorepo",
    "ts-morph"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontbond/dead-props.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "knip": "^6.35.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
